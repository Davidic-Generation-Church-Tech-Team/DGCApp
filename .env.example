NODE_ENV=development
PORT=4000
SERVICE_NAME=dgc-backend
LOG_LEVEL=debug

# Postgres (Render) — ?sslmode=require is mandatory on Render.
DATABASE_URL="postgresql://USER:PASS@HOST.oregon-postgres.render.com/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST.oregon-postgres.render.com/DB?sslmode=require"

# Redis (Render Key Value / Upstash)
REDIS_URL="redis://USER:PASS@HOST:PORT"

# JWT — generate two long random secrets (openssl rand -hex 32)
JWT_ACCESS_SECRET="change-me-32+chars"
JWT_REFRESH_SECRET="change-me-different-32+chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Brevo
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@mail.yourdomain.com"
BREVO_SENDER_NAME="DGC"

# OAuth
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Cloudinary (single URL form)
CLOUDINARY_URL="cloudinary://KEY:SECRET@CLOUD_NAME"

CORS_ORIGIN="*"

# Optional: set to require Authorization: Bearer <token> for /metrics.
METRICS_TOKEN=""

# Agora RTC tokens. Calls still open without these; the phones just have no sound.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
# Agora Media Push. Mixes the mic table into the Bunny station. Enable "Server Side RESTful API"
# on the Agora project first. That switch cannot be turned off again.
AGORA_CUSTOMER_KEY=""
AGORA_CUSTOMER_SECRET=""
# Optional: cn, ap, eu, or na. Empty follows the Bunny ingest region, then eu.
AGORA_MEDIA_PUSH_REGION=""

# Bunny Stream live station. Use the library where a live stream already worked.
# The key is the library API key (AccessKey), not the account API key. Never put a stream key here.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""

# Sentry (optional locally, set in production)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
