// DGC Global Community — backend schema (Prisma 7, driver-adapter mode).
// Design rules live in CLAUDE.md §5. Key principles encoded here:
//   - Permission = role within a scope (roles on membership rows, not User booleans).
//   - Read state = ChannelMembership.lastReadAt; MessageReceipt is DMs only.
//   - The growth pipeline is DATA (GrowthStage / GrowthRequirement / Badge are seeded rows).
//   - Branches & clusters are rows, not enums.
//   - Audit/actor fields (createdById, verifiedById, pinnedById, ...) are plain scalar IDs
//     with NO back-relation, to keep User lean. Integrity enforced in the service layer.
//   - Soft deletes via deletedAt on User and Message.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum GlobalRole {
  MEMBER
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OtpChannel {
  EMAIL
  SMS
}

// What an OTP may be used for. Codes are purpose-bound so a login/registration code
// cannot be replayed to reset a password (and vice versa).
enum OtpPurpose {
  AUTH // register or passwordless sign-in (consumed by /auth/verify-otp)
  RESET // password reset (consumed by /auth/reset-password)
}

enum AuthProviderKind {
  GOOGLE
  APPLE
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum BranchRole {
  MEMBER
  ADMIN
}

enum ClusterRole {
  MEMBER
  MODERATOR
}

enum ChannelRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum ChannelType {
  GLOBAL_ANNOUNCEMENT
  BRANCH_SECTION
  CLUSTER
  DM
  // The singleton "DGC Global Prayer Watch" channel (PRD clarification): every user is auto-joined,
  // members can chat like any other channel, and any member can start a live PRAYER_WATCH audio call
  // inside the channel when none is currently live.
  GLOBAL_PRAYER_WATCH
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
  POLL
  CONTACT
}

enum GrowthStageKey {
  FIRST_TIMER
  NEW_MEMBER
  FOUNDATIONS_GRADUATE
  WORKER
  EMERGING_LEADER
  CELL_LEADER
  ADVANCED_SOM_GRADUATE
  MINISTRY_LEADER
  PASTORATE_CANDIDATE
  PASTORATE
}

// How a requirement completion is recorded (see CLAUDE.md §5).
// URL_UPLOAD = user uploads a file to Cloudinary and posts the URL; the URL itself completes
// the requirement (no admin review). Used for lightweight proofs like service-attendance photos
// or unit-leader attestation letters where speed matters more than fraud prevention.
enum RequirementType {
  AUTO
  SELF_ATTEST
  ADMIN_VERIFY
  CERTIFICATE
  URL_UPLOAD
}

enum CertificateStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum MediaType {
  SERMON
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum AudioRoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

// AudioRoom variety (PRD §8 + Prayer Watch). PRAYER_WATCH rooms are persistent 24hr rooms
// hosted in the Prayer Warriors cluster; CHANNEL_CALL rooms are persistent voice chats scoped
// to one chat channel and ring only that channel's members.
enum AudioRoomType {
  GENERAL
  PRAYER_WATCH
  CHANNEL_CALL
}

// Audio-room roles are EPHEMERAL — tied to the room session, not the user (CLAUDE.md §6.1).
enum AudioRole {
  HOST
  SPEAKER
  LISTENER
}

enum NotificationType {
  MESSAGE
  MENTION
  GROWTH
  EVENT
  ANNOUNCEMENT
  REPORT
  SYSTEM
  CALL
}

// 1:1 DM voice/video calls. Ringing state lives here (not Redis) so a server restart mid-ring
// still ends cleanly via the missed-call scheduler.
enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING    // initiated, not yet answered / declined / cancelled
  ANSWERED   // callee accepted, in call
  DECLINED   // callee tapped decline
  MISSED     // rang out (~30s) without an answer
  ENDED      // one side hung up after ANSWERED
  CANCELLED  // caller cancelled before callee answered
  FAILED     // client couldn't join the Agora channel
}

enum ReportTargetType {
  MESSAGE
  USER
  CHANNEL
  PROFILE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============================================================================
// Auth & identity
// ============================================================================

model User {
  id          String     @id @default(cuid())
  // Identity: a user signs up by email OR phone (OR Google/Apple, which carry an email).
  // Both are nullable+unique so a phone-only or email-only account is valid.
  email        String?    @unique
  globalRole   GlobalRole @default(MEMBER)
  passwordHash String? // null for OTP/OAuth-only accounts; set when the user chooses a password

  // Profile
  displayName String?
  avatarUrl   String?
  phoneNumber String? @unique
  gender      Gender?
  dateOfBirth DateTime? // used for safeguarding / minor handling (CLAUDE.md §9.1)
  lastBirthdayWishYear Int? // Africa/Lagos calendar year of the last birthday wish sent
  occupation  String?
  bio         String?

  // Denormalised pointer to current growth stage (recomputed by the growth engine).
  currentStageId String?
  currentStage   GrowthStage? @relation(fields: [currentStageId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  onboardedAt DateTime? // stamped once when user first completes onboarding (name + branch)
  suspendedAt DateTime? // admin suspension (CLAUDE.md §13); null = active
  lastSeenAt  DateTime? // stamped when the user goes offline (last socket closes or heartbeat lapses)
  deletedAt   DateTime? // soft delete

  // Relations (ownership — not audit fields)
  refreshTokens         RefreshToken[]
  branchMemberships     BranchMembership[]
  clusterMemberships    ClusterMembership[]
  channelMemberships    ChannelMembership[]
  messages              Message[]
  reactions             Reaction[]
  receipts              MessageReceipt[]
  requirementCompletions RequirementCompletion[]
  badges                UserBadge[]
  certificates          Certificate[]
  eventRsvps            EventRSVP[]
  audioParticipations   AudioRoomParticipant[]
  audioRoomReminders    AudioRoomReminder[]
  notifications         Notification[]
  pollVotes             PollVote[]
  reportsFiled          Report[]
  deviceTokens          DeviceToken[]
  authProviders         AuthProvider[]
  callsMade             Call[]                  @relation("CallsMade")
  callsReceived         Call[]                  @relation("CallsReceived")
  blocksMade            UserBlock[]             @relation("BlocksMade")
  blocksReceived        UserBlock[]             @relation("BlocksReceived")

  @@index([currentStageId])
  @@index([deletedAt])
}

// One row per identifier (email or E.164 phone); only a HASH of the OTP is stored (CLAUDE.md §9).
model Otp {
  identifier String     @id // email or phone, normalised (trim + lowercase)
  channel    OtpChannel @default(EMAIL)
  purpose    OtpPurpose @default(AUTH)
  hash       String
  expiresAt  DateTime
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
}

// Only HASHES of refresh tokens are stored; supports rotation + revocation.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  hash      String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// FCM device tokens for push. token is unique (one device); on upsert it's reassigned to the
// current user if the same device is reused. Dead tokens are pruned when FCM rejects them.
model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  voipToken String?
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Third-party auth links. providerSubject is the provider's stable user id (Google `sub`, Apple
// `sub`). Unique per (kind, providerSubject) so no two accounts share the same Google/Apple
// identity, and unique per (userId, kind) so a user has at most one Google link + one Apple link.
// Empty table = the account only has password/OTP auth; presence of rows tells us which OAuth
// providers have been used and lets us support "unlink Google" or per-provider analytics.
model AuthProvider {
  id              String           @id @default(cuid())
  userId          String
  kind            AuthProviderKind
  providerSubject String
  createdAt       DateTime         @default(now())
  lastUsedAt      DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, providerSubject])
  @@unique([userId, kind])
  @@index([userId])
}

// ============================================================================
// Branches & clusters (rows, not enums — CLAUDE.md §5)
// ============================================================================

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  city      String
  country   String   @default("Nigeria")
  createdAt DateTime @default(now())

  memberships BranchMembership[]
  channels    Channel[]
  events      Event[]
}

model BranchMembership {
  id       String     @id @default(cuid())
  userId   String
  branchId String
  role     BranchRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([branchId, joinedAt])
}

model Cluster {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  isDefault   Boolean   @default(false)
  archivedAt  DateTime? // admin archive (CLAUDE.md §13); null = active
  createdAt   DateTime  @default(now())

  memberships ClusterMembership[]
  channels    Channel[]
  events      Event[]
}

model ClusterMembership {
  id        String      @id @default(cuid())
  userId    String
  clusterId String
  role      ClusterRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([userId, clusterId])
  @@index([clusterId])
  @@index([userId])
}

// ============================================================================
// Channels & chat (the real-time core — CLAUDE.md §8.3)
// ============================================================================

model Channel {
  id         String      @id @default(cuid())
  type       ChannelType
  name        String? // null for DMs
  description String?
  isReadOnly  Boolean     @default(false)
  branchId   String?
  clusterId  String?
  createdAt  DateTime    @default(now())

  branch      Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cluster     Cluster?            @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  memberships ChannelMembership[]
  messages    Message[]
  calls       Call[]
  audioRooms  AudioRoom[]

  @@index([branchId])
  @@index([clusterId])
  @@index([type])
}

// Read state lives here: lastReadAt — one row per member per channel (CLAUDE.md §5).
model ChannelMembership {
  id         String      @id @default(cuid())
  userId     String
  channelId  String
  role       ChannelRole @default(MEMBER)
  lastReadAt DateTime?
  mutedAt    DateTime?
  joinedAt   DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

model Message {
  id        String      @id @default(cuid())
  channelId String
  senderId  String
  type      MessageType @default(TEXT)
  title     String? // set for announcements (title + body); null for normal chat messages
  body      String?
  mediaUrl  String? // Cloudinary URL; metadata in Media if catalogued
  clientMessageId String? // client-generated retry key; unique per sender/channel when present
  forwardedFromId String? // original message id when this is a forward (scalar audit field)

  // Contact sharing (type = CONTACT)
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Poll (type = POLL) — details live in the Poll model
  pollId String? @unique
  poll   Poll?   @relation(fields: [pollId], references: [id])

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  // Pin is an audit/actor field — scalar, no back-relation (CLAUDE.md §5).
  pinnedById String?
  pinnedAt   DateTime?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime? // soft delete

  channel  Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender   User             @relation(fields: [senderId], references: [id])
  reactions Reaction[]
  receipts MessageReceipt[]
  attachments MessageAttachment[]

  // Keyset pagination over (channelId, createdAt, id).
  @@unique([senderId, channelId, clientMessageId])
  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([deletedAt])
}

// Ordered media on a message (photo albums). Message.mediaUrl still mirrors the first item so
// clients that only read mediaUrl keep working.
model MessageAttachment {
  id        String      @id @default(cuid())
  messageId String
  url       String // Cloudinary secure_url
  type      MessageType // IMAGE / VIDEO / AUDIO / FILE
  position  Int
  width     Int?
  height    Int?
  createdAt DateTime    @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
}

// Per-message delivered/read — DMs ONLY (CLAUDE.md §5). Never write these for large channels.
model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ============================================================================
// Polls (in-chat voting — CLAUDE.md §7)
// ============================================================================

model Poll {
  id            String       @id @default(cuid())
  question      String
  allowMultiple Boolean      @default(false)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  message Message?
  options PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  text   String
  order  Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
}

// ============================================================================
// Growth pipeline (DATA, not code — CLAUDE.md §5 / §6.2)
// ============================================================================

model GrowthStage {
  id    String         @id @default(cuid())
  key   GrowthStageKey @unique
  order Int            @unique
  name  String

  requirements GrowthRequirement[]
  members      User[] // users currently at this stage (via User.currentStageId)
}

model GrowthRequirement {
  id      String          @id @default(cuid())
  key     String          @unique
  label   String
  type    RequirementType
  stageId String

  stage       GrowthStage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  completions RequirementCompletion[]
  certificates Certificate[]

  @@index([stageId])
}

model RequirementCompletion {
  id            String          @id @default(cuid())
  userId        String
  requirementId String
  source        RequirementType
  verifiedById  String? // scalar audit field — who admin-verified (if applicable)
  fileUrl       String? // Cloudinary URL for URL_UPLOAD requirements; the proof itself
  completedAt   DateTime        @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement GrowthRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([userId, requirementId])
  @@index([requirementId])
}

model Badge {
  id   String @id @default(cuid())
  key  String @unique
  name String
  icon String

  awardedTo UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
}

// Verification queue = Certificate where status = PENDING (CLAUDE.md §5) — a query, not a table.
model Certificate {
  id            String            @id @default(cuid())
  userId        String
  requirementId String?
  title         String
  fileUrl       String // Cloudinary
  status        CertificateStatus @default(PENDING)
  submittedAt   DateTime          @default(now())
  verifiedById  String? // scalar audit field
  verifiedAt    DateTime?
  rejectionReason String?

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement GrowthRequirement? @relation(fields: [requirementId], references: [id])

  @@index([status, submittedAt])
  @@index([userId])
}

// ============================================================================
// Events, media, audio, notifications, moderation
// ============================================================================

model Event {
  id          String    @id @default(cuid())
  branchId    String? // branch event
  clusterId   String? // cluster event; both null = global event
  title       String
  description String?
  location    String?
  imageUrl    String? // optional flyer; the create push sends a small JPEG of this
  startsAt    DateTime
  endsAt      DateTime?
  createdById String // scalar audit field
  createdAt   DateTime  @default(now())
  reminderSentAt DateTime? // set once the day-before reminder has gone out; cleared if startsAt moves

  branch  Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cluster Cluster?    @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  rsvps   EventRSVP[]

  @@index([branchId])
  @@index([clusterId])
  @@index([startsAt])
}

model EventRSVP {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status      RsvpStatus @default(GOING)
  checkedInAt DateTime? // set on QR check-in at the event
  createdAt   DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// Sermons / media library. Store URLs, not files (CLAUDE.md §3). branchId is a scalar (lean).
model Media {
  id           String    @id @default(cuid())
  type         MediaType
  title        String?
  description  String?
  url          String
  thumbnailUrl String?
  branchId     String?
  uploadedById String // scalar audit field
  createdAt    DateTime  @default(now())

  @@index([type])
  @@index([branchId])
}

// Backend issues tokens + tracks roles only; never carries media (CLAUDE.md §3).
model AudioRoom {
  id             String          @id @default(cuid())
  title          String
  description    String?
  channelId      String?
  branchId       String?
  clusterId      String?
  hostId         String // scalar audit field
  status         AudioRoomStatus @default(SCHEDULED)
  // GENERAL rooms auto-end when the host leaves and no speaker remains. PRAYER_WATCH is
  // persistent — cluster moderators come and go, the room stays up until someone explicitly ends it.
  type           AudioRoomType   @default(GENERAL)
  isPersistent   Boolean         @default(false)
  provider       String? // "agora" | "100ms"
  externalRoomId String?
  // Crowd-call station (Prayer Watch and channel calls). playbackUrl is safe to return.
  // bunnyStreamId and agoraConverterId stay on the server. The stream key is not stored.
  playbackUrl      String?
  bunnyStreamId    String?
  agoraConverterId String?
  stationStartedAt DateTime?
  scheduledFor   DateTime?
  reminderSentAt DateTime? // pre-start reminder scan marker (same pattern as Event.reminderSentAt)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime        @default(now())

  channel      Channel?               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participants AudioRoomParticipant[]
  reminders    AudioRoomReminder[]

  @@index([status])
  @@index([channelId, status])
  // Fast lookup for "is there a live prayer watch right now?" (used by the create path to prevent duplicates).
  @@index([type, status])
}

// "Remind Me" on a scheduled room — one row per user per room; fired + cleared when the room goes live.
model AudioRoomReminder {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  createdAt DateTime @default(now())

  room AudioRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model AudioRoomParticipant {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  role     AudioRole @default(LISTENER) // ephemeral, session-scoped
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  room AudioRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([userId])
  @@index([roomId, leftAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String // recipient
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Moderation/reporting is core, not optional (CLAUDE.md §9.1). Anything reportable lands here.
model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  details     String?
  status      ReportStatus     @default(OPEN)
  handledById String? // scalar audit field
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// 1:1 call in a DM channel. `agoraChannel` is the RTC channel name — clients build tokens for
// their own uid via /calls/:id/token so a leaked token can never publish as someone else.
model Call {
  id           String     @id @default(cuid())
  channelId    String     // must be a DM channel
  callerId     String
  calleeId     String
  type         CallType   @default(AUDIO)
  status       CallStatus @default(RINGING)
  agoraChannel String     @unique

  createdAt   DateTime  @default(now()) // = "startedAt" (ringing began)
  answeredAt  DateTime?
  endedAt     DateTime?
  endedById   String?   // scalar audit — who hung up (or system for MISSED)
  durationMs  Int?      // set on end: endedAt - answeredAt (null for MISSED/DECLINED/CANCELLED)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  caller  User    @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee  User    @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  // Busy check: at most one live (RINGING or ANSWERED) call per user at a time.
  @@index([callerId, status])
  @@index([calleeId, status])
  @@index([channelId, createdAt]) // call history for a DM
  @@index([status, createdAt])    // sweeper for stuck-RINGING rows
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}
